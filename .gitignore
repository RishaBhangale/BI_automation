# ── Environments & Credentials (CRITICAL - NEVER COMMIT) ──────────────────
.env
.env.*
!.env.example
playwright/.auth/browser_profile/
playwright/.auth/*.json
!playwright/.auth/.gitkeep
!playwright/.auth/.keep

# ── Virtual Environments ──────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python Bytecode & Cache ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── Frontend (Node / Vite / React) ─────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.output/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Generated Database Cache ────────────────────────────────────────────────
reports/excel_source_cache/
*.sqlite
*.db

# ── Execution Logs, Screenshots & Temp Artifacts ───────────────────────────
logs/*
!logs/.keep
!logs/.gitkeep
screenshots/*
!screenshots/.keep
!screenshots/.gitkeep
test-results/

# ── Office & OS Temporary Files ────────────────────────────────────────────
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
*.tmp
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE & Editor Configuration ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
